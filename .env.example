# Copy this file to .env.local and fill in the values, then rebuild.
# Both variables are read at build time and baked into the static export.

# Form endpoint that accepts a JSON POST, for example:
#   Web3Forms  https://api.web3forms.com/submit
#   Formspree  https://formspree.io/f/your-form-id
# Leave empty to make the form open a pre-filled WhatsApp (or email) message.
NEXT_PUBLIC_FORM_ENDPOINT=

# Only needed for Web3Forms: the access key from your Web3Forms dashboard.
NEXT_PUBLIC_FORM_ACCESS_KEY=
